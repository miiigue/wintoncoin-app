# ═══════════════════════════════════════════════════════════════════════════
# WINTONCOIN BACKEND - VARIABLES DE ENTORNO
# ═══════════════════════════════════════════════════════════════════════════

# ─── BASE DE DATOS ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:password@localhost:5432/wintoncoin

# ─── SEGURIDAD Y AUTENTICACIÓN ────────────────────────────────────────────
JWT_SECRET=tu_jwt_secret_super_seguro_aqui
OTP_SECRET=tu_otp_secret_diferente_del_jwt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu_password_admin_seguro
PLATFORM_USERNAME=Plataforma WintonCoin

# ─── AWS SES (Email) ───────────────────────────────────────────────────────
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@wintoncoin.com
SES_FROM_NAME=WintonCoin
SUPPORT_EMAIL=support@wintoncoin.com

# ─── BRANDING ──────────────────────────────────────────────────────────────
BRAND_PRIMARY_COLOR=#0B5FFF
BRAND_LOGO_URL=https://sc.wintoncoin.com/assets/branding/wintoncoin_phrase_blue.png

# ─── WEB PUSH NOTIFICATIONS ───────────────────────────────────────────────
VAPID_PUBLIC_KEY=tu_vapid_public_key
VAPID_PRIVATE_KEY=tu_vapid_private_key
VAPID_SUBJECT=mailto:support@wintoncoin.com

# ─── WEBAUTHN (Gobernanza — huella / Face ID) ──────────────────────────────
# El servidor usa la cabecera Origin del navegador para fijar rpId (demo vs prod).
# Lista adicional opcional (orígenes completos, separados por coma):
# WEBAUTHN_ALLOWED_ORIGINS=https://demo.wintoncoin.com,https://www.demo.wintoncoin.com,https://sc.wintoncoin.com
# Si no hay Origin (scripts internos), se usan estos dos como respaldo:
# WEBAUTHN_RP_ID=demo.wintoncoin.com
# WEBAUTHN_ORIGIN=https://demo.wintoncoin.com

# ─── FRONTEND URL (para links en emails) ───────────────────────────────────
# OPCIONAL: El sistema auto-detecta el entorno basado en NODE_ENV y DATABASE_URL
# Solo configura esto si necesitas sobreescribir la detección automática.
# FRONTEND_URL=http://localhost:3000        # Local
# FRONTEND_URL=https://demo.wintoncoin.com    # Demo
# FRONTEND_URL=https://sc.wintoncoin.com      # Producción

# ─── ENTORNO ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
