# ==========================================
# CONFIGURACIÓN PARA EL ENTORNO "DEMO"
# ==========================================
# Usa este archivo como plantilla para configurar las variables de entorno 
# en tu servidor de despliegue (Render/Hostinger) para la versión DEMO.

# --- BASE DE DATOS (IMPORTANTE: USAR UNA NUEVA VACÍA) ---
# Crea una base de datos nueva llamada 'wintoncoin_demo'
DATABASE_URL="postgresql://usuario:password@host:5432/wintoncoin_demo"

# --- SEGURIDAD ---
# Indica que este es el entorno demo (habilita herramientas de prueba inseguras)
IS_DEMO_ENV=true
NODE_ENV=production

# Claves Secretas (Pueden ser diferentes a producción para seguridad)
JWT_SECRET=demo_secret_key_change_this_for_security
ADMIN_SECRET_KEY=demo_admin_secret
ADMIN_PASSWORD=demo_admin_password

# --- CUENTAS DE SISTEMA ---
# Estas credenciales se usarán para el usuario "SISTEMA" en la demo
PLATFORM_USERNAME="Plataforma WintonCoin"
PLATFORM_USER_PASSWORD=demo_platform_password

# --- SERVICIOS EXTERNOS (OPCIONALES EN DEMO) ---
# Puedes dejar estos vacíos o usar credenciales de prueba si quieres probar SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- APARIENCIA ---
BRAND_LOGO_URL=https://assets.zyrosite.com/A3Qavv5DlzuJ63Zk/logo-200transparente-png-ZZP1CFUmo2ykd8K8.png
