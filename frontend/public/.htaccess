# ============================================================================
# WintonCoin - Apache / LiteSpeed Configuration (.htaccess para Hostinger)
# ============================================================================
# Configuración profesional de Cache-Control y entrega de assets según
# los estándares de la industria (FinTech / Big Tech / Zero-Trust).
# ============================================================================

<IfModule mod_headers.c>
    # 1. HTML y Service Workers: NUNCA retener en caché estático
    # Garantiza que el navegador siempre consulte la versión viva más reciente
    <FilesMatch "\.(html|htm|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    <FilesMatch "(sw\.js|sw-source\.js|registerSW\.js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # 2. Assets empaquetados con Hash de Vite (JS, CSS): Caché Inmutable de 1 año
    # Como Vite cambia el nombre del archivo en cada compilación (name.hash.js),
    # el usuario descarga instantáneamente el nuevo archivo sin colisiones ni recargas.
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # 3. Multimedia y Tipografías: Caché de 30 días
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # 4. Cabeceras de Seguridad Básicas
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Habilitar compresión Gzip para entrega ultra-rápida
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# ============================================================================
# 5. ENRUTAMIENTO SPA (Single Page Application) - Apache / LiteSpeed (Hostinger)
# ============================================================================
# Permite que rutas como /register, /login y /forgot-password sean atendidas por
# la SPA React en index.html sin arrojar error 404 en Hostinger.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Si la petición apunta a un archivo físico o carpeta que existe realmente, servirlo tal cual
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rutas SPA migradas a React: enrutar internamente a index.html (preservando query string)
    RewriteRule ^(register|login|forgot-password|home|wallet|exchange|admin/web3|admin-web3)$ index.html [L,QSA]
</IfModule>
