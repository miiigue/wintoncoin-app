{
  "name": "wintoncoin-frontend",
  "version": "1.5.0",
  "type": "module",
  "description": "WintonCoin Frontend - PWA con Vite + Workbox",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run check:react && vite build",
    "build:demo": "npm run check:react && vite build --mode demo",
    "preview": "vite preview",
    "lint": "eslint src --ext .js",
    "test:wallet": "node scripts/check-wallet-render.cjs",
    "check:react": "node scripts/check-react-references.cjs",
    "test:account-security": "node scripts/check-account-security.cjs",
    "test:pwa": "node scripts/check-pwa-build.cjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.10",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "^7.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@safe-global/protocol-kit": "8.0.7",
    "@safe-global/safe-modules-deployments": "3.0.10",
    "@simplewebauthn/browser": "^9.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "buffer": "6.0.3",
    "ethers": "^6.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  }
}
